    "stanza.soli.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Glut entzündet sich, wenn sich jemand zu dir setzt. Schick den Code, wem du an deiner Seite willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ember will light when someone sits with you. Send the code to whoever you want beside you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La brasa se encenderá cuando alguien se siente contigo. Envía el código a quien quieras a tu lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La braise s'allumera quand quelqu'un s'assiéra avec toi. Envoie le code à qui tu veux à tes côtés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La brace si accenderà quando qualcuno si siederà con te. Manda il codice a chi vuoi accanto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A brasa se acenderá quando alguém se sentar com você. Envie o código a quem quiser ao seu lado."
          }
        }
      }
    },
    "stanza.soli.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Tisch spricht man mindestens zu zweit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A table needs at least two voices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la mesa se habla al menos entre dos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À table, on parle au moins à deux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A tavola si parla almeno in due"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À mesa se fala pelo menos em dois"
          }
        }
      }
    },
    "stanza.tavolo.section": {
