    "onboarding.nome.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat deinen Namen nicht geteilt: Schreib ihn selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't share your name: write it yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ha compartido tu nombre: escríbelo tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas partagé ton nom : écris-le toi-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non ha condiviso il tuo nome: scrivilo tu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não compartilhou seu nome: escreva você."
          }
        }
      }
    },
    "onboarding.nome.placeholder": {
      "extractionState": "manual",
      "localizations": {
