            "state": "translated",
            "value": "«%@» está puesta. Invita a alguien a sentarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est dressée. Invite quelqu'un à s'asseoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è apparecchiato. Invita qualcuno a sedersi."
