    "regola.nutre.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Like: eine stille Geste für „das hat mich genährt“. Es gibt keine Rangliste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a like: a quiet gesture to say \"this nourished me\". It makes no ranking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un like: un gesto discreto para decir «esto me ha nutrido». No hace ranking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas un like : un geste discret pour dire « cela m'a nourri ». Aucun classement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non un like: un gesto discreto per dire «questo mi ha nutrito». Non fa classifica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é um like: um gesto discreto para dizer \"isto me nutriu\". Não faz ranking."
          }
        }
      }
    },
