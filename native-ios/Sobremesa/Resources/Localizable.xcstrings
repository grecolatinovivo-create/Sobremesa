    "regola.sedia.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %1$lld Tagen Schweigen eine Erinnerung, nach %2$lld wird der Stuhl frei. Wer den Tisch gründet, verliert ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After %1$lld days of silence, a reminder; after %2$lld, the chair frees up. Whoever starts the table never loses theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras %1$lld días de silencio, un recordatorio; tras %2$lld, la silla se libera. Quien funda la mesa nunca la pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après %1$lld jours de silence, un rappel ; après %2$lld, la chaise se libère. Qui fonde la table ne la perd jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo %1$lld giorni di silenzio un promemoria; dopo %2$lld la sedia si libera. Chi fonda il tavolo non la perde mai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após %1$lld dias de silêncio, um lembrete; após %2$lld, a cadeira fica livre. Quem funda a mesa nunca a perde."
          }
        }
      }
    },
    "regola.sedia.title": {
      "extractionState": "manual",
      "localizations": {
