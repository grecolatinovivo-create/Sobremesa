    "tu.reset.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto, Beiträge und deine Tische verschwinden für immer, vom Telefon und vom Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, remarks and the tables you host disappear forever, from the phone and the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta, intervenciones y mesas que animas desaparecen para siempre, del teléfono y del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte, tes interventions et les tables que tu animes disparaissent pour toujours, du téléphone et du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
