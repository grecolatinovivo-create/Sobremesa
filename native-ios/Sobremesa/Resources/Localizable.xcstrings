    "conferma.alzati.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Stuhl wird frei und das Gespräch geht ohne dich weiter. Keine Strafe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chair frees up and the conversation continues without you. No penalty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu silla se libera y la conversación sigue sin ti. Sin penalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta chaise se libère et la conversation continue sans toi. Aucune pénalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sedia si libera e la conversazione prosegue senza di te. Nessuna penalità."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cadeira se libera e a conversa continua sem você. Nenhuma penalidade."
          }
        }
      }
    },
    "conferma.alzati.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Tisch aufstehen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand up from this table?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Levantarte de esta mesa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te lever de cette table ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzarti da questo tavolo?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar-se desta mesa?"
          }
        }
      }
    },
    "conferma.chiudi.azione": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für alle schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close for everyone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra para todos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme pour tous"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi per tutti"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche para todos"
          }
        }
      }
    },
    "conferma.chiudi.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist der Animator: Wenn du aufstehst, schließt der Tisch für alle und das Gespräch endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the animator: if you stand up, the table closes for everyone and the conversation ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el animador: si te levantas, la mesa se cierra para todos y la conversación termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es l'animateur : si tu te lèves, la table ferme pour tous et la conversation s'achève."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei l'animatore: se ti alzi, il tavolo si chiude per tutti e la conversazione finisce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o animador: se se levantar, a mesa fecha para todos e a conversa termina."
          }
        }
      }
    },
    "conferma.chiudi.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tisch schließen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
