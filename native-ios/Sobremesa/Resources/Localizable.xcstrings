    "tu.presenza.spiega": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen lässt deine Präsenz wachsen, langes Schweigen lässt sie sinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaking makes your presence grow; a long silence makes it fall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hablar hace crecer tu presencia; un largo silencio la hace bajar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler fait grandir ta présence ; un long silence la fait baisser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlare fa crescere la presenza; un lungo silenzio la fa calare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falar faz a presença crescer; um longo silêncio a faz cair."
          }
        }
      }
    },
