    "regola.tavolo.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Themengespräch mit höchstens %1$lld Stühlen. Du kannst an %2$lld Tischen sitzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A themed conversation with at most %1$lld chairs. You can sit at %2$lld tables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación temática con %1$lld sillas como máximo. Puedes sentarte a %2$lld mesas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une conversation à thème, %1$lld chaises au plus. Tu peux t'asseoir à %2$lld tables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
