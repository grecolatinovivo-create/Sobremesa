    "invito.messaggio": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich zu mir an „%1$@“ auf Sobremesa: %3$@\n(Code %2$@)"
