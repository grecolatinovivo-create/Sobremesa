    "regola.presenza.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl von 0 bis 100, die nur du siehst. Die anderen sehen ein Wort: Lebendige Stimme ab %1$lld, Stille Präsenz ab %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number from 0 to 100 that only you see. Others see a word: Living voice from %1$lld, Quiet presence from %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número de 0 a 100 que solo ves tú. A los demás les llega una palabra: Voz viva desde %1$lld, Presencia discreta desde %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre de 0 à 100 que toi seul·e vois. Les autres voient un mot : Voix vive dès %1$lld, Présence discrète dès %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numero da 0 a 100 che vedi solo tu. Agli altri arriva una parola: Voce viva da %1$lld, Presenza discreta da %2$lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um número de 0 a 100 que só você vê. Aos outros chega uma palavra: Voz viva a partir de %1$lld, Presença discreta a partir de %2$lld."
          }
        }
      }
    },
