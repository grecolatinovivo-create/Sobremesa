    "fonda.nome.errore": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name muss sein, auch ein kurzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It needs a name, even a short one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace falta un nombre, aunque sea breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut un nom, même court."
          }
        },
        "it": {
          "stringUnit": {
