        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las brasas de «%1$@» casi se apagan (%2$lld a tu puntuación). Retoma la palabra cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La braise de « %1$@ » a failli s'éteindre (%2$lld au score). Reprends la parole quand tu veux."
