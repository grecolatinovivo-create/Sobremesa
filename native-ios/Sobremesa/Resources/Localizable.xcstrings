    "fonda.chiuso.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintritt nur auf Anfrage: Du entscheidest, wer sitzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry by request only: you'll decide who sits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se entra solo a petición: tú decidirás quién se sienta."
          }
        },
        "fr": {
