    "stanza.soli.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald ihr mindestens zu zweit seid, beginnt die Glut zu leben. Lade jemanden ein, Platz zu nehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once there are at least two of you, the ember will come alive. Invite someone to sit down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando seáis al menos dos, la brasa empezará a vivir. Invita a alguien a sentarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous serez au moins deux, la braise commencera à vivre. Invite quelqu'un à s'asseoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sarete almeno in due, la brace comincerà a vivere. Invita qualcuno a sedersi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando forem pelo menos dois, a brasa começará a viver. Convide alguém para se sentar."
          }
        }
      }
    },
    "stanza.soli.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch bist du allein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now, it's just you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora estás tú solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, tu es seul·e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora siete in uno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por enquanto, é só você."
          }
        }
      }
    },
