    "regola.sedia.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schweigst du seit %1$lld Tagen, erinnern wir dich behutsam; nach %2$lld wird der Stuhl für jemand anderen frei. Wer den Tisch gegründet hat, verliert ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you've been silent for %1$lld days we'll gently remind you; after %2$lld the chair frees up for someone else. Whoever started the table never loses theirs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si callas durante %1$lld días te lo recordamos con tacto; después de %2$lld la silla se libera para otra persona. Quien fundó la mesa nunca la pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu te tais depuis %1$lld jours, on te le rappelle avec tact ; après %2$lld, la chaise se libère pour quelqu'un d'autre. Qui a fondé la table ne la perd jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se taci da %1$lld giorni te lo ricordiamo con garbo; dopo %2$lld la sedia si libera per qualcun altro. Chi ha fondato il tavolo non la perde mai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você se cala há %1$lld dias, lembramos com delicadeza; depois de %2$lld a cadeira fica livre para outra pessoa. Quem fundou a mesa nunca a perde."
          }
        }
      }
    },
    "regola.sedia.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Stuhl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chair"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu silla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta chaise"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sedia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cadeira"
          }
        }
      }
    },
    "regola.tavolo.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Themengespräch mit höchstens %1$lld Stühlen. Du kannst an %2$lld Tischen gleichzeitig sitzen: wenige, ausgewählte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A themed conversation with at most %1$lld chairs. You can sit at %2$lld tables at once: few, chosen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación temática con como máximo %1$lld sillas. Puedes sentarte a %2$lld mesas a la vez: pocas, elegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une conversation à thème, avec au plus %1$lld chaises. Tu peux t'asseoir à %2$lld tables à la fois : peu, choisies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversazione a tema, con al massimo %1$lld sedie. Puoi sedere a %2$lld tavoli insieme: pochi, scelti."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa temática com no máximo %1$lld cadeiras. Você pode se sentar a %2$lld mesas ao mesmo tempo: poucas, escolhidas."
          }
        }
      }
    },
