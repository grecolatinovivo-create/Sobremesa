    "regola.brace.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist die Wärme des Tisches: Sie bleibt lebendig, wenn in den letzten %lld Stunden jemand gesprochen hat, dann verglimmt sie. Mit nur einer Person wartet sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the table's warmth: it stays alive if someone has spoken in the last %lld hours, then it fades. With just one person, it waits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el calor de la mesa: sigue viva si alguien habló en las últimas %lld horas; luego se apaga. Con una sola persona, espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la chaleur de la table : elle reste vive si quelqu'un a parlé dans les %lld dernières heures, puis elle s'affaiblit. Avec une seule personne, elle attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il calore del tavolo: resta viva se qualcuno ha parlato nelle ultime %lld ore, poi si affievolisce. Con una sola persona, aspetta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É o calor da mesa: fica viva se alguém falou nas últimas %lld horas; depois esmorece. Com uma só pessoa, espera."
          }
        }
      }
    },
    "regola.brace.title": {
