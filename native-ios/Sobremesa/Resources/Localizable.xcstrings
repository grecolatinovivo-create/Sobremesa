            "value": "Ti avviso quando la tua brace si sta spegnendo, prima che il posto si liberi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’ll let you know when your ember is fading, before your seat is freed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te aviso cuando tu brasa se apaga, antes de que se libere tu sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je te préviens quand ta braise faiblit, avant que ta place se libère."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sage dir Bescheid, wenn deine Glut verlischt, bevor dein Platz frei wird."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso quando a tua brasa estiver se apagando, antes que o teu lugar fique livre."
          }
        }
      }
    },
