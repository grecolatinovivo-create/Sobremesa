          "stringUnit": {
            "state": "translated",
            "value": "Die Kerze brennt, wenn in den letzten %lld Stunden jemand gesprochen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The candle is lit if someone has spoken in the last %lld hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vela está encendida si alguien habló en las últimas %lld horas."
