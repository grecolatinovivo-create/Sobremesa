    "notif.avviso.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit %1$lld Tagen schweigt „%2$@“. Ergreife das Wort — oder decke für eine neue Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence at \"%2$@\" for %1$lld days. Retake the floor — or set a place for a new voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde hace %1$lld días se calla en «%2$@». Retoma la palabra — o pon un sitio para una voz nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence à « %2$@ » depuis %1$lld jours. Reprends la parole — ou dresse un couvert pour une voix nouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da %1$lld giorni si tace a «%2$@». Riprendi la parola — o apparecchia per una voce nuova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Há %1$lld dias há silêncio em \"%2$@\". Retome a palavra — ou ponha um lugar para uma voz nova."
          }
        }
      }
    },
