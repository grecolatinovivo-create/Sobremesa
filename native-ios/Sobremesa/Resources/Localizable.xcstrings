    "regola.nutre.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Like: Es sagt „das hat mich genährt“. Keine Zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a like: it says \"this nourished me\". No numbers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un like: dice «esto me ha nutrido». Sin números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas un like : il dit « cela m'a nourri ». Aucun chiffre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non un like: dice «questo mi ha nutrito». Nessun numero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é um like: diz \"isto me nutriu\". Sem números."
          }
        }
      }
    },
