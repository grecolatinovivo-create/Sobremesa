    "stanza.vuota": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch ist bereit. Brich du das Schweigen: Das erste Wort entfacht die Glut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table is set. Break the silence: the first word lights the ember."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa está lista. Rompe tú el silencio: la primera palabra enciende la brasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table est prête. Romps le silence : le premier mot allume la braise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tavolo è pronto. Rompi tu il silenzio: la prima parola accende la brace."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa está pronta. Quebre você o silêncio: a primeira palavra acende a brasa."
          }
        }
      }
    },
    "stanza.vuota.soli": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch ist gedeckt. Während du auf Gesellschaft wartest, kannst du den ersten Gedanken dalassen: Wer sich setzt, findet ihn vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table is set. While you wait for company, you can leave the first thought: whoever sits down will find it waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa está puesta. Mientras esperas compañía, puedes dejar el primer pensamiento: quien se siente lo encontrará esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table est dressée. En attendant la compagnie, tu peux laisser la première pensée : qui s'assiéra la trouvera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tavolo è apparecchiato. Mentre aspetti compagnia, puoi lasciare il primo pensiero: chi si siederà lo troverà ad accoglierlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa está posta. Enquanto espera companhia, pode deixar o primeiro pensamento: quem se sentar o encontrará à espera."
          }
        }
      }
    },
