    },
    "fonda.spiega": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dem Tisch einen Namen und sag, worum es geht. Wer ihn gründet, ist sein Animator: Er hält die Glut am Leben und entscheidet, wer sitzt, falls er geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the table and say what it's about. The founder is its animator: they keep the ember alive and decide who sits, if it's closed to strangers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale un nombre a la mesa y di de qué se habla. Quien la funda es su animador: mantiene viva la brasa y decide quién se sienta, si está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne un nom à la table et dis de quoi on y parle. Le fondateur en est l'animateur : il garde la braise vivante et décide qui s'assoit, si elle est fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome al tavolo e di' di cosa si parla. Chi lo fonda ne è l'animatore: tiene accesa la brace e decide chi si siede, se lo chiude agli estranei."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome à mesa e diga do que se fala. Quem a funda é seu animador: mantém a brasa viva e decide quem se senta, se estiver fechada."
          }
        }
      }
    },
    "fonda.tema": {
