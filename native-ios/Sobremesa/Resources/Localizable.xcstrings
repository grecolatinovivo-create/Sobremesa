    "regola.presenza.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl von 0 bis 100, die mit deiner Teilnahme wächst: Lebendige Stimme ab %1$lld, Stille Präsenz ab %2$lld. Nur du siehst sie; die anderen sehen ein Wort, nie die Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A number from 0 to 100 that grows as you take part: Living voice from %1$lld, Quiet presence from %2$lld. Only you see it; others see a word, never the number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número de 0 a 100 que crece participando: Voz viva desde %1$lld, Presencia discreta desde %2$lld. Solo lo ves tú; a los demás les llega una palabra, nunca el número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre de 0 à 100 qui grandit en participant : Voix vive dès %1$lld, Présence discrète dès %2$lld. Toi seul·e le vois ; les autres voient un mot, jamais le nombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numero da 0 a 100 che cresce partecipando: Voce viva da %1$lld, Presenza discreta da %2$lld. Lo vedi solo tu; agli altri arriva una parola, mai il numero."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um número de 0 a 100 que cresce participando: Voz viva a partir de %1$lld, Presença discreta a partir de %2$lld. Só você o vê; aos outros chega uma palavra, nunca o número."
          }
        }
      }
    },
    "regola.presenza.title": {
