    "tu.manifesto.text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobremesa ist die Zeit, die nach dem Essen am Tisch bleibt. Wenige Stühle, wenige Tische, kein Algorithmus: nur Gespräche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobremesa is the time that lingers at the table after the meal. Few chairs, few tables, no algorithm: just conversations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobremesa es el tiempo que queda en la mesa cuando la comida ha terminado. Pocas sillas, pocas mesas, ningún algoritmo: solo conversaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobremesa, c'est le temps qui reste à table après le repas. Peu de chaises, peu de tables, aucun algorithme : seulement des conversations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobremesa è il tempo che resta a tavola quando il pasto è finito. Poche sedie, pochi tavoli, nessun algoritmo: solo conversazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobremesa é o tempo que fica à mesa depois da refeição. Poucas cadeiras, poucas mesas, nenhum algoritmo: só conversas."
          }
        }
      }
    },
