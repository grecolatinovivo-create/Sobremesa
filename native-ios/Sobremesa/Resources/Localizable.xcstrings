    "toast.penalita": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Glut von „%1$@“ wäre fast erloschen (%2$lld auf den Wert). Ergreife das Wort, wann du willst."
