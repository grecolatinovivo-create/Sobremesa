    "salotto.vuoto.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Salon wartet: Entdecke die offenen Tische oder gib einen Code ein, um einem Gespräch beizutreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parlor is waiting: explore the open tables or enter a code to join a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El salón te espera: explora las mesas abiertas o introduce un código para unirte a una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
