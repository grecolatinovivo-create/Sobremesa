    "onboarding.privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name und was du schreibst, liegen auf deinem Gerät und dem Sobremesa-Server – nur, damit du an Tischen sitzen kannst. Keine Werbung, kein Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name and what you write live on your device and on Sobremesa's server, only to seat you at tables. No ads, no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre y lo que escribes viven en tu dispositivo y en el servidor de Sobremesa, solo para sentarte a las mesas. Sin publicidad, sin rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton nom et ce que tu écris vivent sur ton appareil et sur le serveur de Sobremesa, uniquement pour t'asseoir aux tables. Pas de publicité, pas de pistage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome e ciò che scrivi vivono sul tuo dispositivo e sul server di Sobremesa, solo per farti sedere ai tavoli. Niente pubblicità, niente tracciamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome e o que você escreve ficam no seu dispositivo e no servidor do Sobremesa, só para sentá-lo às mesas. Sem anúncios, sem rastreamento."
          }
        }
      }
    },
