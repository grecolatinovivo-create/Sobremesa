    "tu.rituale.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einziger Ruf am Tag, zur Zeit deiner Wahl: der Moment, am Tisch zu bleiben. Kein weiteres Drängen, nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One single call a day, at the time you choose: the moment to linger at the table. No other nagging, ever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola llamada al día, a la hora que elijas: el momento de quedarse en la mesa. Ninguna otra insistencia, nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul rappel par jour, à l'heure que tu choisis : le moment de rester à table. Aucune autre insistance, jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo richiamo al giorno, all'ora che scegli tu: il momento di restare a tavola. Nessun'altra insistenza, mai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único chamado por dia, na hora que você escolher: o momento de ficar à mesa. Nenhuma outra insistência, nunca."
          }
        }
      }
    },
