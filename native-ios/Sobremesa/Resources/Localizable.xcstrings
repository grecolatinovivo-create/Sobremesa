    "toast.rifiutato": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch konnte die letzte Aktion nicht aufnehmen: Der Stand wurde abgeglichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table couldn't accommodate that last action: things have been realigned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa no pudo acoger la última acción: la situación se ha realineado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table n'a pas pu accueillir la dernière action : la situation a été réalignée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
