            "value": "Sobremesa non raggiunge la tavola comune: l'ultima azione non è arrivata al server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sobremesa não alcança a mesa comum: sua última ação não chegou ao servidor."
          }
        }
      }
    },
    "toast.penalita": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Glut von „%1$@“ wäre fast erloschen (%2$lld auf den Wert). Ergreife das Wort, wann du willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embers of “%1$@” nearly went out (%2$lld to your score). Take the floor again whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las brasas de «%1$@» casi se apagan (%2$lld a tu puntuación). Retoma la palabra cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La braise de « %1$@ » a failli s'éteindre (%2$lld au score). Reprends la parole quand tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La brace di «%1$@» si è quasi spenta (%2$lld al punteggio). Riprendi la parola quando vuoi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As brasas de “%1$@” quase se apagaram (%2$lld na pontuação). Retome a palavra quando quiser."
          }
        }
      }
    },
