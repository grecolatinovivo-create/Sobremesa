    "tu.presenza.spiega": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Beitrag zählt +%1$lld, das Wort wieder ergreifen +%2$lld; langes Schweigen kostet −%3$lld. Es zählt die Sorgfalt des Daseins, nicht die Menge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every remark is worth +%1$lld, retaking the floor +%2$lld; a long silence costs −%3$lld. What counts is the care of being there, not the quantity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada intervención vale +%1$lld, retomar la palabra +%2$lld; un largo silencio cuesta −%3$lld. Cuenta el cuidado de estar, no la cantidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque intervention vaut +%1$lld, reprendre la parole +%2$lld ; un long silence coûte −%3$lld. Ce qui compte, c'est le soin d'être là, pas la quantité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni intervento vale +%1$lld, riprendere la parola +%2$lld; un lungo silenzio costa −%3$lld. Conta la cura di esserci, non la quantità."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada intervenção vale +%1$lld, retomar a palavra +%2$lld; um longo silêncio custa −%3$lld. Conta o cuidado de estar presente, não a quantidade."
          }
        }
      }
    },
