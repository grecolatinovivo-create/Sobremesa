    "onboarding.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Tische, je zwölf Stühle, eine Glut, die man am Leben hält. Tritt mit deinem Namen ein und setz dich — oder decke deinen ersten Tisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five tables, twelve chairs each, an ember to keep alive. Enter with your name and take a seat — or set your first table."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco mesas, doce sillas cada una, una brasa que mantener viva. Entra con tu nombre y siéntate — o pon tu primera mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq tables, douze chaises chacune, une braise à garder vivante. Entre avec ton nom et assieds-toi — ou dresse ta première table."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque tavoli, dodici sedie l'uno, una brace da tenere viva. Entra col tuo nome e siediti — o apparecchia il tuo primo tavolo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco mesas, doze cadeiras cada, uma brasa para manter viva. Entre com seu nome e sente-se — ou ponha a sua primeira mesa."
          }
        }
      }
    },
    "onboarding.nome.conferma": {
      "extractionState": "manual",
      "localizations": {
