          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa não pôde acolher a última ação: a situação foi realinhada."
          }
        }
      }
    },
    "toast.tavolo.fondato": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist gedeckt. Lade jemanden zum Sitzen ein."
          }
