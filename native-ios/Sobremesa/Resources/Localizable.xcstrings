    "invito.messaggio": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich zu mir an „%1$@“ auf Sobremesa. Der Tisch-Code lautet: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with me at \"%1$@\" on Sobremesa. The table code is: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate conmigo en «%1$@» en Sobremesa. El código de la mesa es: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assieds-toi avec moi à « %1$@ » sur Sobremesa. Le code de la table est : %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti con me a «%1$@» su Sobremesa. Il codice del tavolo è: %2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se comigo em \"%1$@\" no Sobremesa. O código da mesa é: %2$@"
          }
        }
      }
    },
    "invito.spiega": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Code, ein Stuhl: Wer ihn einlöst, sitzt an DIESEM Tisch. Die Stühle sind, was sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One code, one chair: whoever redeems it sits at THIS table. The chairs are what they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código, una silla: quien lo canjea se sienta en ESTA mesa. Las sillas son las que son."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code, une chaise : qui l'utilise s'assoit à CETTE table. Les chaises sont ce qu'elles sont."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un codice, una sedia: chi lo riscatta si siede a QUESTO tavolo. Le sedie sono quelle che sono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um código, uma cadeira: quem o resgata senta-se NESTA mesa. As cadeiras são as que são."
          }
        }
      }
    },
