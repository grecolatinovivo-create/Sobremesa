    "notif.rituale.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tische warten. Der Luxus, sitzen zu bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tables await. The luxury of lingering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
