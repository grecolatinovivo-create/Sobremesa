    "onboarding.privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name und was du teilst leben auf deinem Gerät und auf Sobremesas Server, nur damit ihr am selben Tisch sitzen könnt. Keine Werbung, kein Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name and what you share live on your device and on Sobremesa's server, only so you can sit at the same table. No ads, no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre y lo que compartes viven en tu dispositivo y en el servidor de Sobremesa, solo para sentaros a la misma mesa. Sin publicidad, sin rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton nom et ce que tu partages vivent sur ton appareil et sur le serveur de Sobremesa, seulement pour vous asseoir à la même table. Pas de pub, pas de traçage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome e ciò che condividi vivono sul tuo dispositivo e sul server di Sobremesa, solo per sedervi alla stessa tavola. Niente pubblicità, niente tracciamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome e o que você compartilha vivem no seu aparelho e no servidor do Sobremesa, só para sentarem à mesma mesa. Sem anúncios, sem rastreamento."
          }
        }
      }
    },
    "onboarding.tagline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit am Tisch, wenn das Essen vorbei ist und niemand aufstehen mag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time you linger at the table when the meal is over and nobody wants to get up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo que se queda en la mesa cuando la comida terminó y nadie quiere levantarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps qu'on reste à table quand le repas est fini et que personne ne veut se lever."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo che resta a tavola quando il pasto è finito e nessuno ha voglia di alzarsi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo que se fica à mesa quando a refeição acabou e ninguém quer se levantar."
          }
        }
      }
    },
