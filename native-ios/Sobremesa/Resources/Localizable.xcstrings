    "stanza.vuota": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch ist gedeckt und die Glut bereit. Eröffne du das Gespräch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table is set and the ember is ready. You open the conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa está puesta y la brasa lista. Abre tú la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table est dressée et la braise est prête. Ouvre la conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tavolo è apparecchiato e la brace è pronta. Apri tu la conversazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa está posta e a brasa pronta. Abra você a conversa."
          }
        }
      }
    },
    "stanza.vuota.soli": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch ist gedeckt. Während du auf Gesellschaft wartest, kannst du den ersten Gedanken dalassen: Wer sich setzt, findet ihn vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table is set. While you wait for company, you can leave the first thought: whoever sits down will find it waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa está puesta. Mientras esperas compañía, puedes dejar el primer pensamiento: quien se siente lo encontrará esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table est dressée. En attendant la compagnie, tu peux laisser la première pensée : qui s'assiéra la trouvera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tavolo è apparecchiato. Mentre aspetti compagnia, puoi lasciare il primo pensiero: chi si siederà lo troverà ad accoglierlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa está posta. Enquanto espera companhia, pode deixar o primeiro pensamento: quem se sentar o encontrará à espera."
          }
        }
      }
    },
