    "onboarding.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulturelle Gespräche, langsam und lebendig. Setz dich an einen Tisch, hör zu, sprich mit, bleib."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cultural conversations, slow and alive. Sit at a table, listen, speak, stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversaciones culturales, lentas y vivas. Siéntate a una mesa, escucha, interviene, quédate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des conversations culturelles, lentes et vivantes. Assieds-toi à une table, écoute, interviens, reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversazioni culturali, lente e vive. Siediti a un tavolo, ascolta, intervieni, resta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas culturais, lentas e vivas. Sente-se a uma mesa, ouça, participe, fique."
          }
        }
      }
    },
