    "tu.rituale.attiva": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnere mich jeden Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me every day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuérdamelo cada día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappelle-le-moi chaque jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricordamelo ogni giorno"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembre-me todos os dias"
          }
        }
