    "salotto.vuoto.testo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Sobremesa geschieht alles an Tischen: Themengespräche, wenige Stühle, eine Glut, die man am Leben hält. Finde einen offenen Tisch oder gründe deinen eigenen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At Sobremesa everything happens at tables: themed conversations, few chairs, an ember to keep alive. Find an open table, or start your own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Sobremesa todo sucede en las mesas: conversaciones temáticas, pocas sillas, una brasa que mantener viva. Encuentra una mesa abierta, o funda la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chez Sobremesa, tout se passe autour des tables : conversations à thème, peu de chaises, une braise à garder vivante. Trouve une table ouverte, ou fonde la tienne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sobremesa tutto succede ai tavoli: conversazioni a tema, poche sedie, una brace da tenere viva. Trova un tavolo aperto, o fondane uno tuo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No Sobremesa tudo acontece nas mesas: conversas temáticas, poucas cadeiras, uma brasa para manter viva. Encontre uma mesa aberta, ou funde a sua."
          }
        }
      }
    },
    "salotto.vuoto.title": {
